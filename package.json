{
  "name": "resume-match-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "prisma generate || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
