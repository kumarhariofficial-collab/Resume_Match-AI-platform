# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumematch?schema=public"

# Authentication
NEXTAUTH_SECRET="dev-secret-key-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Engine Providers (OpenAI / Gemini)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_LLM_PROVIDER="openai" # options: openai | gemini

# Storage Configuration (S3 / Cloudflare R2 / Supabase Storage)
S3_ENDPOINT=""
S3_BUCKET_NAME="resumematch-storage"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# Email Services
RESEND_API_KEY=""
EMAIL_FROM="noreply@resumematch.ai"

# Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
